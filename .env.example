PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=interntm
# true = auto-create/update tables (development only!). Use migrations in production.
DB_SYNC=true

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# First admin account (created on startup if it doesn't exist)
ADMIN_EMAIL=admin@interntm.tm
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=InternTM Admin

# Insert demo categories/companies/internships when DB is empty
SEED_DEMO=true
